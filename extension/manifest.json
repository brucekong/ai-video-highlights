{
  "manifest_version": 3,
  "name": "AI Video Highlights Helper",
  "version": "1.0.0",
  "description": "Helps AI Video Highlights safely and privately fetch video subtitles using your local browser.",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://*.bilibili.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.yourdomain.com/*",
    "https://yourdomain.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://www.youtube.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Video Helper"
  }
}
