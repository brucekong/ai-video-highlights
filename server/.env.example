# Database - PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/ai_video_highlights?schema=public"

# DeepSeek API Key (get from https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# Groq API Key for Whisper fallback (get from https://console.groq.com)
GROQ_API_KEY="your-groq-api-key-here"

# Optional: absolute path to ffmpeg binary for partial clip downloads
FFMPEG_PATH="/absolute/path/to/ffmpeg"

# Server port
PORT=3001

# --- Auth Secrets ---
JWT_SECRET="your_custom_jwt_secret_change_me"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

WECHAT_APP_ID="your_wechat_app_id"
WECHAT_APP_SECRET="your_wechat_app_secret"
WECHAT_REDIRECT_URI="http://localhost:3001/api/auth/wechat/callback"
