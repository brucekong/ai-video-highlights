generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

/// 视频信息
model Video {
  id                  String                 @id @default(cuid())
  videoId             String                 @unique @map("video_id")
  url                 String
  title               String?
  platform            String                 @default("youtube")
  duration            Int?
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  mindmap             String?                @map("mindmap")
  category            String?                @map("category")
  tags                String?                @map("tags")
  videoDescription    String?                @map("video_description")
  videoHashtags       String?                @map("video_hashtags")
  embedding           Unsupported("vector(1024)")?
  translatedEmbedding Unsupported("vector(1024)")? @map("translated_embedding")
  chatMessages        ChatMessage[]
  subtitles           Subtitle[]
  takeaways           Takeaway[]
  histories           UserHistory[]

  @@map("videos")
}

/// 用户信息
model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  name          String?
  avatar        String?
  googleId      String?       @unique @map("google_id")
  wechatOpenId  String?       @unique @map("wechat_open_id")
  wechatUnionId String?       @unique @map("wechat_union_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  chatMessages  ChatMessage[]
  histories     UserHistory[]

  @@map("users")
}

/// AI 聊天记录
model ChatMessage {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@index([videoId, userId])
  @@map("chat_messages")
}

/// 用户分析历史
model UserHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  videoId   String   @map("video_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("user_history")
}

/// AI 提取的关键要点
model Takeaway {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  title     String
  summary   String?
  timestamp Int
  duration  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@map("takeaways")
}

/// 视频字幕（缓存）
model Subtitle {
  id                  String                 @id @default(cuid())
  videoId             String                 @map("video_id")
  text                String
  translatedText      String?                @map("translated_text")
  offset              Int
  duration            Int
  sortOrder           Int                    @default(0) @map("sort_order")
  embedding           Unsupported("vector(1024)")?
  translatedEmbedding Unsupported("vector(1024)")? @map("translated_embedding")
  createdAt           DateTime               @default(now()) @map("created_at")
  video               Video                  @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@map("subtitles")
}
