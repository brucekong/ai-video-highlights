generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

/// 视频信息
model Video {
  id                  String                 @id @default(cuid())
  videoId             String                 @unique @map("video_id")
  url                 String
  title               String?
  platform            String                 @default("youtube")
  duration            Int?
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  mindmap             String?                @map("mindmap")
  category            String?                @map("category")
  tags                String?                @map("tags")
  videoDescription    String?                @map("video_description")
  videoHashtags       String?                @map("video_hashtags")
  channelsTitle       String?                @map("channels_title")
  keywordGlossary     Json?                  @map("keyword_glossary")
  redbookTitle        String?                @map("redbook_title")
  redbookDescription  String?                @map("redbook_description")
  redbookHashtags     String?                @map("redbook_hashtags")
  embedding           Unsupported("vector(1024)")?
  translatedEmbedding Unsupported("vector(1024)")? @map("translated_embedding")
  chatMessages        ChatMessage[]
  subtitles           Subtitle[]
  subtitleCues        SubtitleCue[]
  takeaways           Takeaway[]
  histories           UserHistory[]
  publishAssets       PublishAsset[]

  @@map("videos")
}

/// 用户信息
model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  name          String?
  avatar        String?
  googleId      String?       @unique @map("google_id")
  wechatOpenId  String?       @unique @map("wechat_open_id")
  wechatUnionId String?       @unique @map("wechat_union_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  chatMessages  ChatMessage[]
  histories     UserHistory[]

  @@map("users")
}

/// AI 聊天记录
model ChatMessage {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  userId    String   @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@index([videoId, userId])
  @@map("chat_messages")
}

/// 用户分析历史
model UserHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  videoId   String   @map("video_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("user_history")
}

/// AI 提取的关键要点
model Takeaway {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  title     String
  summary   String?
  timestamp Int
  duration  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  video     Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@map("takeaways")
}

/// 视频字幕（缓存）
model Subtitle {
  id                  String                 @id @default(cuid())
  videoId             String                 @map("video_id")
  text                String
  translatedText      String?                @map("translated_text")
  offset              Int
  duration            Int
  sortOrder           Int                    @default(0) @map("sort_order")
  embedding           Unsupported("vector(1024)")?
  translatedEmbedding Unsupported("vector(1024)")? @map("translated_embedding")
  createdAt           DateTime               @default(now()) @map("created_at")
  video               Video                  @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@map("subtitles")
}

/// 派生字幕 Cue（用于展示和导出）
model SubtitleCue {
  id                   String   @id @default(cuid())
  videoId              String   @map("video_id")
  text                 String
  translatedText       String?  @map("translated_text")
  overrideText         String?  @map("override_text")
  overrideTranslatedText String? @map("override_translated_text")
  offset               Int
  duration             Int
  sortOrder            Int      @default(0) @map("sort_order")
  sourceStartSortOrder Int      @map("source_start_sort_order")
  sourceEndSortOrder   Int      @map("source_end_sort_order")
  layoutVersion        Int      @default(1) @map("layout_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  video                Video    @relation(fields: [videoId], references: [videoId], onDelete: Cascade)

  @@unique([videoId, sortOrder])
  @@index([videoId, offset])
  @@map("subtitle_cues")
}

/// 本地物料（已加工完成、待发布的视频包）
model PublishAsset {
  id              String        @id @default(cuid())
  videoId         String?       @map("video_id")
  title           String
  description     String?
  hashtags        String?
  videoFilePath   String        @map("video_file_path")
  cover43Path     String?       @map("cover_43_path")   // 4:3 封面
  cover34Path     String?       @map("cover_34_path")   // 3:4 封面
  status          String        @default("draft") // draft | ready | publishing | published | failed
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  video           Video?        @relation(fields: [videoId], references: [videoId])
  publishTasks    PublishTask[]

  @@map("publish_assets")
}

/// 发布任务（一个物料可发布到多个平台）
model PublishTask {
  id            String       @id @default(cuid())
  assetId       String       @map("asset_id")
  platform      String       // douyin | xiaohongshu | bilibili | wxvideo
  platformTitle String?      @map("platform_title")
  platformDesc  String?      @map("platform_desc")
  publishMode   String       @default("draft") @map("publish_mode") // draft | publish
  status        String       @default("pending") // pending | running | draft_saved | published | failed | retrying
  errorMessage  String?      @map("error_message")
  publishedAt   DateTime?    @map("published_at")
  publishedUrl  String?      @map("published_url")
  retryCount    Int          @default(0) @map("retry_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  asset         PublishAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([status])
  @@map("publish_tasks")
}

/// 平台账号配置
model PlatformAccount {
  id          String   @id @default(cuid())
  platform    String   @unique // douyin | xiaohongshu | bilibili | wxvideo
  displayName String   @map("display_name")
  isActive    Boolean  @default(true) @map("is_active")
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_accounts")
}
