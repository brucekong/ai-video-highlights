  {
    "text": "&gt;&gt; Chicken is the best.",
    "duration": 5.44,
    "offset": 61.92,
    "lang": "en"
  },
  {
    "text": "&gt;&gt; Stop. Stop.",
    "duration": 5.68,
    "offset": 64.08,
    "lang": "en"
  },
  {
    "text": "I have a great idea.",
    "duration": 4.96,
    "offset": 67.36,
    "lang": "en"
  },
  {
    "text": "A solution for everyone.",
    "duration": 8.32,
    "offset": 69.76,
    "lang": "en"
